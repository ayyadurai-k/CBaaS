# ====================================
# Stage 1: Build the React application
# ====================================
FROM node:20-alpine as build

# Set working directory for the build stage
WORKDIR /app

# Copy package files for dependency installation
# Copying these first allows Docker to cache this layer if dependencies haven't changed
COPY package*.json ./

# Install dependencies using npm ci for consistent, reproducible builds
# npm ci is faster and more reliable than npm install in CI/CD environments
RUN npm ci

# Copy all source files into the container
# This includes src/, public/, tsconfig.json, vite.config.ts, etc.
COPY . .

# Build the production-optimized React application
# Vite will bundle and minify the app, output to /app/dist
# Environment variables from .env.production are embedded at build time
RUN npm run build

# ====================================
# Stage 2: Serve with Nginx
# ====================================
FROM nginx:alpine

# Copy custom Nginx configuration to handle React Router (SPA routing)
# This ensures all routes are served by index.html for client-side routing
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copy the built static files from the build stage to Nginx's serve directory
# This is a multi-stage build optimization - only production artifacts are included
COPY --from=build /app/dist /usr/share/nginx/html

# Expose port 80 for HTTP traffic
EXPOSE 80

# Start Nginx in the foreground (daemon off prevents container from exiting)
CMD ["nginx", "-g", "daemon off;"]
